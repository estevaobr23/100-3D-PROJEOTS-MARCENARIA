# Variáveis do app. Copie para .env.local (dev) e configure na Vercel (prod).
# NUNCA commite valores reais. Este arquivo é só a lista.

# --- Supabase -----------------------------------------------------------
# ⚠️ As duas NEXT_PUBLIC_* NÃO podem ser marcadas "Sensitive" na Vercel:
#    variável sensitive não existe durante o build e é inlinada como undefined.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Só servidor. Confira que o payload do JWT diz "service_role" e não "anon".
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Sessão -----------------------------------------------------------------
# Gere um por projeto:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<hex de 32 bytes>

# ==========================================================================
# Webhook da Cakto — quando houver produto/checkout. NÃO configurado ainda.
# ==========================================================================
# O secret fica no SUPABASE (Edge Function), não aqui. Na Cakto o secret
# viaja no CORPO da requisição (body.secret), não em header.
#
# 🚨 Criar o secret NÃO basta: o webhook da Cakto escuta uma LISTA EXPLÍCITA
#    de produtos. Produto fora da lista vende e nunca dispara evento — o
#    painel mostra success_rate 100% porque só conta o que chega. Vincular o
#    produto ao webhook ao criá-lo, e travar por script. Isso já custou
#    R$1.431,20 / 68 acessos não entregues em outra área.
